[gd_resource type="Resource" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/systems/mission_definition.gd" id="1"]
[ext_resource type="Script" path="res://scripts/systems/mission_step.gd" id="2"]

[sub_resource type="Resource" id="SellHorse"]
script = ExtResource("2")
kind = 2
objective = "Спешьтесь и поговорите с Игнатом Фроловым — E"
target = NodePath("HorseDelivery/Frolov")
contact_name = "Игнат Фролов"
radius = 2.3
inspection_subject = NodePath("HorseDelivery/DeliveryHorse")
cash_total = 50
cash_share = 20
conversation = PackedStringArray("Копыта целы, зубы хорошие. Беру. Вот пятьдесят рублей, как условились.", "Двадцать за доставку, тридцать отвезу Баранову.")

[sub_resource type="Resource" id="PayBaranov"]
script = ExtResource("2")
kind = 2
objective = "Вернитесь к Баранову и передайте ему 30 рублей — E"
target = NodePath("StoryContacts/Baranov")
contact_name = "Савелий Кузьмич Баранов"
radius = 2.2
keep_on_retry = true
settles_payment = true
conversation = PackedStringArray("Тридцать, всё верно. Фролов про документы ничего не спрашивал?", "Нет. А что с ними?", "Да ничего. Просто печать на них поставили раньше, чем выписали саму купчую. Забудь.")

[resource]
script = ExtResource("1")
id = "a_profitable_deal"
title = "Выгодная сделка"
steps = Array[ExtResource("2")]([SubResource("SellHorse"), SubResource("PayBaranov")])
